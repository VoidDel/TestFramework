<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TestFramework.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F1F5F9" />
          <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppCardBorderBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="AppInnerBorderBrush" Color="#F1F5F9" />
          <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#64748B" />
          <SolidColorBrush x:Key="AppLogBackgroundBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="AppLogForegroundBrush" Color="#38BDF8" />

          <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#1D4ED8" />
          <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFF" />
          
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#059669" />
          <SolidColorBrush x:Key="AppSuccessHoverBrush" Color="#047857" />

          <SolidColorBrush x:Key="AppWarningBrush" Color="#D97706" />

          <SolidColorBrush x:Key="AppDangerBrush" Color="#DC2626" />
          <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#B91C1C" />

          <SolidColorBrush x:Key="AppBadgeBackgroundBrush" Color="#F1F5F9" />
          <SolidColorBrush x:Key="AppTreeHoverBackgroundBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="AppTreeSelectedBackgroundBrush" Color="#EFF6FF" />
          <SolidColorBrush x:Key="AppTreeSelectedBorderBrush" Color="#BFDBFE" />

          <!-- 覆盖 Fluent TreeViewItem 主题色，让树 hover/选中状态与整体配色一致 -->
          <StaticResource x:Key="TreeViewItemBackgroundPointerOver" ResourceKey="AppTreeHoverBackgroundBrush" />
          <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="AppTreeSelectedBackgroundBrush" />
          <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="AppTreeSelectedBackgroundBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#1E293B" />
          <SolidColorBrush x:Key="AppCardBorderBrush" Color="#334155" />
          <SolidColorBrush x:Key="AppInnerBorderBrush" Color="#293548" />
          <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#94A3B8" />
          <SolidColorBrush x:Key="AppLogBackgroundBrush" Color="#0B0F19" />
          <SolidColorBrush x:Key="AppLogForegroundBrush" Color="#38BDF8" />

          <SolidColorBrush x:Key="AppAccentBrush" Color="#3B82F6" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#60A5FA" />
          <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFF" />
          
          <SolidColorBrush x:Key="AppSuccessBrush" Color="#10B981" />
          <SolidColorBrush x:Key="AppSuccessHoverBrush" Color="#34D399" />

          <SolidColorBrush x:Key="AppWarningBrush" Color="#FBBF24" />

          <SolidColorBrush x:Key="AppDangerBrush" Color="#EF4444" />
          <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#F87171" />

          <SolidColorBrush x:Key="AppBadgeBackgroundBrush" Color="#334155" />
          <SolidColorBrush x:Key="AppTreeHoverBackgroundBrush" Color="#273549" />
          <SolidColorBrush x:Key="AppTreeSelectedBackgroundBrush" Color="#1E3A8A" />
          <SolidColorBrush x:Key="AppTreeSelectedBorderBrush" Color="#3B82F6" />

          <!-- 覆盖 Fluent TreeViewItem 主题色，让树 hover/选中状态与整体配色一致 -->
          <StaticResource x:Key="TreeViewItemBackgroundPointerOver" ResourceKey="AppTreeHoverBackgroundBrush" />
          <StaticResource x:Key="TreeViewItemBackgroundSelected" ResourceKey="AppTreeSelectedBackgroundBrush" />
          <StaticResource x:Key="TreeViewItemBackgroundSelectedPointerOver" ResourceKey="AppTreeSelectedBackgroundBrush" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- SVG StreamGeometry Icons -->
      <StreamGeometry x:Key="IconSequence">M4 5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2H4V5zm0 4h16v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9zm2 2v2h4v-2H6zm0 4v2h8v-2H6z</StreamGeometry>
      <StreamGeometry x:Key="IconItem">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z</StreamGeometry>
      <StreamGeometry x:Key="IconInit">M7 2v11h3v9l7-12h-4l4-8z</StreamGeometry>
      <StreamGeometry x:Key="IconMain">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z</StreamGeometry>
      <StreamGeometry x:Key="IconCleanup">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</StreamGeometry>
      <StreamGeometry x:Key="IconStep">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
      <StreamGeometry x:Key="IconPlus">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
      <StreamGeometry x:Key="IconSave">M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z</StreamGeometry>
      <StreamGeometry x:Key="IconSaveAs">M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .5l3.5-3.5 1.42 1.42L12 16.34l-5.92-5.92L7.5 9l3.5 3.5V3h2v9.5z</StreamGeometry>
      <StreamGeometry x:Key="IconDelete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
      <StreamGeometry x:Key="IconRun">M8 5v14l11-7z</StreamGeometry>
      <StreamGeometry x:Key="IconStop">M6 6h12v12H6z</StreamGeometry>
      <StreamGeometry x:Key="IconVariable">M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z</StreamGeometry>
      <StreamGeometry x:Key="IconLog">M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-5 14H4v-4h11v4zm0-5H4V9h11v4zm5 5h-4V9h4v9z</StreamGeometry>
      <StreamGeometry x:Key="IconClear">M15 16h4v2h-4zm0-8h4v2h-4zm0 4h4v2h-4zM3 18c0 1.1.9 2 2 2h6c1.1 0 2-.9 2-2V8H3v10zM14 5h-3l-1-1H6L5 5H2v2h12V5z</StreamGeometry>
      <StreamGeometry x:Key="IconCopy">M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z</StreamGeometry>
      <StreamGeometry x:Key="IconEdit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>
      <StreamGeometry x:Key="IconPlugin">M20.5 11H19V7c0-1.1-.9-2-2-2h-4V3.5C13 2.12 11.88 1 10.5 1S8 2.12 8 3.5V5H4c-1.1 0-1.99.9-1.99 2v3.8H3.5c1.49 0 2.7 1.21 2.7 2.7s-1.21 2.7-2.7 2.7H2V20c0 1.1.9 2 2 2h3.8v-1.5c0-1.49 1.21-2.7 2.7-2.7s2.7 1.21 2.7 2.7V22H17c1.1 0 2-.9 2-2v-4h1.5c1.38 0 2.5-1.12 2.5-2.5s-1.12-2.5-2.5-2.5z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
      <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
      <StreamGeometry x:Key="IconSun">M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .39-.39.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z</StreamGeometry>
      <StreamGeometry x:Key="IconMoon">M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- 卡片容器：精细边框与柔和圆角 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #0A0F172A, 0 6 16 -4 #0F0F172A" />
    </Style>

    <!-- 卡片内部的分组框 -->
    <Style Selector="Border.inner">
      <Setter Property="Background" Value="{DynamicResource AppInnerBorderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <!-- 状态胶囊 -->
    <Style Selector="Border.status-pill">
      <Setter Property="Background" Value="{DynamicResource AppBadgeBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinWidth" Value="160" />
    </Style>

    <!-- 运行中状态点脉冲动画 -->
    <Style Selector="Ellipse.status-running">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.3" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- 树节点圆角与背景过渡 -->
    <Style Selector="TreeViewItem">
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 区域标题 -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- 次要说明文字 -->
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AppSubtleTextBrush}" />
    </Style>

    <!-- 表单字段标签 -->
    <Style Selector="TextBlock.form-label">
      <Setter Property="Margin" Value="0,8,0,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppSubtleTextBrush}" />
    </Style>

    <!-- 通用按钮优化 -->
    <Style Selector="Button">
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 按钮背景色淡入淡出，hover 更细腻 -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Ghost 按钮：透明底，hover 时淡色底，用于次要操作 -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppTreeHoverBackgroundBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppCardBorderBrush}" />
    </Style>

    <!-- 核心 Accent 按钮 -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
    </Style>

    <!-- 成功/运行按钮 -->
    <Style Selector="Button.success">
      <Setter Property="Background" Value="{DynamicResource AppSuccessBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSuccessHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- 危险/删除按钮 -->
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppDangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- 实心红色停止按钮（运行中的运行按钮切换而来） -->
    <Style Selector="Button.stop">
      <Setter Property="Background" Value="{DynamicResource AppDangerBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppDangerHoverBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 分隔条：精细与拖拽效果 -->
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <!-- 日志框：科技暗黑控制台风格 -->
    <Style Selector="TextBox.log">
      <Setter Property="Background" Value="{DynamicResource AppLogBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppLogForegroundBrush}" />
      <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Menlo, Monospace" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource AppLogBackgroundBrush}" />
    </Style>
    <Style Selector="TextBox.log:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource AppLogBackgroundBrush}" />
    </Style>
  </Application.Styles>
</Application>

