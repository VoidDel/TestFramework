<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- An application, not a library other projects consume. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="..\TestFramework.Abstractions\TestFramework.Abstractions.csproj" />
    <ProjectReference Include="..\TestFramework.Core\TestFramework.Core.csproj" />
    <ProjectReference Include="..\TestFramework.SequenceYaml\TestFramework.SequenceYaml.csproj" />
    <ProjectReference Include="..\TestFramework.Plugin.Abstractions.UI\TestFramework.Plugin.Abstractions.UI.csproj" />
  </ItemGroup>

  <!--
    The built-in steps are a plugin package, not part of the app. ReferenceOutputAssembly="false"
    keeps them off the compile references - nothing here may name their types - while still making
    them build first, so the copy below always has something current to take.
  -->
  <ItemGroup>
    <ProjectReference Include="..\TestFramework.Plugins.BasicSteps\TestFramework.Plugins.BasicSteps.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      OutputItemType="BundledPlugin" />
    <ProjectReference Include="..\TestFramework.Plugins.BasicSteps.UI\TestFramework.Plugins.BasicSteps.UI.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      OutputItemType="BundledPlugin" />
  </ItemGroup>

  <!--
    Stages the built-in plugin package where a deployed plugin would sit, so running from the build
    output exercises the same discovery path a third-party plugin takes.
  -->
  <Target Name="CopyBundledPlugins" AfterTargets="Build">
    <Copy SourceFiles="@(BundledPlugin)"
          DestinationFolder="$(OutDir)Plugins\BasicSteps"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
