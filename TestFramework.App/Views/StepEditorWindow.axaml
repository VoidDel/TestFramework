<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TestFramework.App.Views.StepEditorWindow"
        Title="编辑 Step"
        Width="600"
        Height="780"
        MinWidth="520"
        MinHeight="620"
        Background="{DynamicResource AppWindowBackgroundBrush}">
  <Grid RowDefinitions="*,Auto" Margin="12">
    <Border Classes="card">
      <ScrollViewer>
        <StackPanel>
          <TextBlock Classes="section-title" Text="Step 属性" />
          <TextBlock Classes="form-label" Text="名称" />
          <TextBox Name="StepNameBox" TextChanged="StepNameBox_OnTextChanged" />
          <CheckBox Name="StepEnabledBox" Content="启用" Margin="0,10,0,0" IsCheckedChanged="StepEnabledBox_OnChanged" />
          <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Classes="form-label" Text="插件" />
              <TextBox Name="StepPluginBox" IsReadOnly="True" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Classes="form-label" Text="超时 ms" />
              <TextBox Name="TimeoutBox" PlaceholderText="留空表示不超时" TextChanged="TimeoutBox_OnTextChanged" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="form-label" Text="错误处理" />
          <ComboBox Name="ErrorHandlingBox" HorizontalAlignment="Stretch" SelectionChanged="ErrorHandlingBox_OnSelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Separator Margin="0,16,0,6" />

          <ContentControl Name="PluginSettingsContent" />

          <Separator Margin="0,16,0,6" />

          <TextBlock Classes="section-title" Text="原始参数" Margin="0,6,0,0" />
          <ListBox Name="ParametersList" Height="140" Margin="0,6,0,0" SelectionChanged="ParametersList_OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                  <TextBlock Classes="hint" Text="{Binding ValueText}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Classes="form-label" Text="键" />
              <TextBox Name="ParameterKeyBox" TextChanged="ParameterKeyBox_OnTextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Classes="form-label" Text="值" />
              <TextBox Name="ParameterValueBox" TextChanged="ParameterValueBox_OnTextChanged" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
            <Button Content="添加参数" Click="AddParameter_OnClick" />
            <Button Content="删除" Click="DeleteParameter_OnClick" />
          </StackPanel>

          <Separator Margin="0,16,0,6" />

          <TextBlock Classes="section-title" Text="变量写入" Margin="0,6,0,0" />
          <ListBox Name="VariableWritesList" Height="140" Margin="0,6,0,0" SelectionChanged="VariableWritesList_OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Classes="hint" Text="{Binding SourceText}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Classes="form-label" Text="变量名" />
          <TextBox Name="VariableWriteNameBox" TextChanged="VariableWriteNameBox_OnTextChanged" />
          <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Classes="form-label" Text="输出键" />
              <TextBox Name="VariableWriteOutputKeyBox" PlaceholderText="留空则使用固定值" TextChanged="VariableWriteOutputKeyBox_OnTextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Classes="form-label" Text="固定值" />
              <TextBox Name="VariableWriteValueBox" PlaceholderText="字面值或 ${变量名}" TextChanged="VariableWriteValueBox_OnTextChanged" />
            </StackPanel>
          </Grid>
          <CheckBox Name="VariableWriteOnErrorBox" Content="错误时也写入" Margin="0,10,0,0" IsCheckedChanged="VariableWriteOnErrorBox_OnChanged" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
            <Button Content="添加写入" Click="AddVariableWrite_OnClick" />
            <Button Content="删除" Click="DeleteVariableWrite_OnClick" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="关闭" MinWidth="88" Click="Close_OnClick" />
    </StackPanel>
  </Grid>
</Window>
