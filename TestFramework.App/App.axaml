<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TestFramework.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F3F4F6" />
          <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppCardBorderBrush" Color="#D8DEE4" />
          <SolidColorBrush x:Key="AppInnerBorderBrush" Color="#EAEEF2" />
          <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#57606A" />
          <SolidColorBrush x:Key="AppLogBackgroundBrush" Color="#F6F8FA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#191A1C" />
          <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#2B2D30" />
          <SolidColorBrush x:Key="AppCardBorderBrush" Color="#43454A" />
          <SolidColorBrush x:Key="AppInnerBorderBrush" Color="#3A3C40" />
          <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#9DA3AB" />
          <SolidColorBrush x:Key="AppLogBackgroundBrush" Color="#222426" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- 卡片容器：主题感知的边框与背景 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <!-- 卡片内部的分组框 -->
    <Style Selector="Border.inner">
      <Setter Property="BorderBrush" Value="{DynamicResource AppInnerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
    </Style>

    <!-- 区域标题 -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 次要说明文字 -->
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AppSubtleTextBrush}" />
    </Style>

    <!-- 表单字段标签 -->
    <Style Selector="TextBlock.form-label">
      <Setter Property="Margin" Value="0,10,0,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AppSubtleTextBrush}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- 分隔条：默认透明，悬停时提示可拖拽 -->
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="GridSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppCardBorderBrush}" />
    </Style>

    <!-- 日志框：固定底色，悬停/聚焦时不被主题状态色覆盖 -->
    <Style Selector="TextBox.log">
      <Setter Property="Background" Value="{DynamicResource AppLogBackgroundBrush}" />
      <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,Menlo,Monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource AppLogBackgroundBrush}" />
    </Style>
    <Style Selector="TextBox.log:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource AppLogBackgroundBrush}" />
    </Style>
  </Application.Styles>
</Application>
