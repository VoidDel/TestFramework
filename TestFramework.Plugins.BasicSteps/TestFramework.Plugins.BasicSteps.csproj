<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A plugin ships as a DLL dropped into a host's plugin folder, never as a package
         reference, so nothing can take a compile-time dependency on it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TestFramework.Abstractions\TestFramework.Abstractions.csproj" />
  </ItemGroup>
</Project>
