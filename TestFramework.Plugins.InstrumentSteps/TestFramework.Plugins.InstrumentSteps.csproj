<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A plugin ships as a DLL dropped into a host's plugin folder, never as a package
         reference, so nothing can take a compile-time dependency on it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TestFramework.Abstractions\TestFramework.Abstractions.csproj" />
    <ProjectReference Include="..\TestFramework.Instruments\TestFramework.Instruments.csproj" />
  </ItemGroup>

  <!--
    Staged into artifacts/plugins/InstrumentSteps, the folder a host copies from and the release
    zips. Only this assembly: Abstractions and Instruments are shared from the host.
  -->
  <Target Name="StageInstrumentStepsPluginPackage" AfterTargets="Build">
    <ItemGroup>
      <InstrumentStepsPluginFile Include="$(OutDir)TestFramework.Plugins.InstrumentSteps.dll" />
      <InstrumentStepsPluginFile Include="$(OutDir)TestFramework.Plugins.InstrumentSteps.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(InstrumentStepsPluginFile)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\artifacts\plugins\InstrumentSteps"
          SkipUnchangedFiles="true"
          Condition="Exists('%(FullPath)')" />
  </Target>
</Project>
