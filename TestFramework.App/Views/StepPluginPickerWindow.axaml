<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TestFramework.App.Views.StepPluginPickerWindow"
        Title="选择 Step 类型"
        Width="500"
        Height="580"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <PathIcon Data="{StaticResource IconPlugin}" Width="20" Height="20" Foreground="{DynamicResource AppAccentBrush}" />
      <StackPanel>
        <TextBlock Classes="section-title" Text="选择 Step 插件" />
        <TextBlock Classes="hint" Margin="0,2,0,0" Text="按插件分类查看；双击具体 Step 可快速添加。" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Margin="0,14,0,0" Padding="10">
      <TreeView Name="PluginTree" Background="Transparent" DoubleTapped="PluginTree_OnDoubleTapped">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
              <PathIcon Data="{Binding IconData}" Width="15" Height="15" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Medium" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
      <Button Content="取消" Click="Cancel_OnClick" />
      <Button Classes="accent" MinWidth="96" Click="Add_OnClick">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" Foreground="#FFFFFF" />
          <TextBlock Text="添加 Step" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</Window>
