<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>TestFramework.Core</PackageId>
    <Description>Sequence runner, plugin loading and resource management for TestFramework hosts.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TestFramework.Abstractions\TestFramework.Abstractions.csproj" />
    <!-- Not for Core's own use: the instrument classes are shared from the host into every plugin
         folder (PluginAssemblyLoadContext.IsSharedWithHost), so every host must carry them, and a
         host gets everything Core depends on. -->
    <ProjectReference Include="..\TestFramework.Instruments\TestFramework.Instruments.csproj" />
  </ItemGroup>
</Project>
