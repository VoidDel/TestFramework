<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:input="clr-namespace:Avalonia.Input;assembly=Avalonia.Base"
             x:Class="TestFramework.App.Views.SequenceEditorView">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="512*" MinHeight="320" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="200*" MinHeight="120" />
    </Grid.RowDefinitions>

    <!-- 顶部工具栏：序列切换 + 文件操作 + 运行 -->
    <Border Classes="card" Padding="12,8" Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="section-title" Text="测试序列" VerticalAlignment="Center" />
          <ComboBox Name="SequenceCombo" MinWidth="260" MaxWidth="420" VerticalAlignment="Center" SelectionChanged="SequenceCombo_OnSelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <TextBlock Grid.Column="1" Name="StatusText" Classes="hint"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="12,0" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Name="NewButton" Content="新建" Click="New_OnClick" />
          <Button Name="SaveButton" Content="保存" Click="Save_OnClick" />
          <Button Name="SaveAsButton" Content="另存" Click="SaveAs_OnClick" />
          <Button Name="DeleteSequenceButton" Content="删除" Click="DeleteSequence_OnClick" />
          <Button Name="RunButton" Classes="accent" Content="运行" MinWidth="88" Click="Run_OnClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主内容区：三栏按比例分配，分隔条可拖拽调整 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300*" MinWidth="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="636*" MinWidth="380" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="300*" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <Border Classes="card" Grid.Column="0">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Classes="section-title" Text="序列结构" />
          <StackPanel Grid.Row="1">
            <TextBlock Classes="form-label" Text="名称" />
            <TextBox Name="SequenceNameBox" TextChanged="SequenceNameBox_OnTextChanged" />
          </StackPanel>
          <Grid Grid.Row="2" RowDefinitions="*,Auto" Margin="0,10,0,0">
            <TreeView Name="SequenceTree" input:DragDrop.AllowDrop="True"
                      SelectionChanged="SequenceTree_OnSelectionChanged"
                      DoubleTapped="SequenceTree_OnDoubleTapped"
                      KeyDown="SequenceTree_OnKeyDown"
                      input:DragDrop.DragOver="SequenceTree_OnDragOver"
                      input:DragDrop.Drop="SequenceTree_OnDrop">
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="DragDrop.AllowDrop" Value="True" />
                  <Setter Property="ContextMenu">
                    <ContextMenu>
                      <MenuItem Header="增加测试项" Click="AddItem_OnClick" />
                      <MenuItem Header="删除测试项" Click="DeleteTreeNode_OnClick" />
                      <Separator />
                      <MenuItem Header="增加 Step" Click="AddStep_OnClick" />
                      <MenuItem Header="编辑 Step" Click="EditStep_OnClick" />
                      <MenuItem Header="复制 Step" Click="CopyStep_OnClick" />
                      <MenuItem Header="删除 Step" Click="DeleteTreeNode_OnClick" />
                    </ContextMenu>
                  </Setter>
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <TextBlock Text="{Binding Title}" />
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
              <Button Content="添加测试项" Click="AddItem_OnClick" />
              <Button Content="删除测试项" Click="DeleteItem_OnClick" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

      <Border Classes="card" Grid.Column="2">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid RowDefinitions="Auto,Auto,Auto">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="section-title" Text="测试项" />
                <TextBox Name="ItemNameBox" Margin="0,6,0,0" TextChanged="ItemNameBox_OnTextChanged" />
              </StackPanel>
              <CheckBox Grid.Column="1" Name="ItemEnabledBox" Content="启用" Margin="12,0,0,0"
                        VerticalAlignment="Bottom" IsCheckedChanged="ItemEnabledBox_OnChanged" />
            </Grid>

            <Border Classes="inner" Grid.Row="1" Margin="0,12,0,0">
              <Grid RowDefinitions="Auto,Auto,Auto">
                <TextBlock Classes="hint" FontWeight="SemiBold" Text="判定设置" />
                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,2,0,0">
                  <StackPanel Margin="0,0,6,0">
                    <TextBlock Classes="form-label" Text="判定 Step" />
                    <ComboBox Name="VerdictStepCombo" HorizontalAlignment="Stretch" SelectionChanged="VerdictStepCombo_OnSelectionChanged">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Classes="form-label" Text="判定输出键" />
                    <TextBox Name="VerdictOutputBox" PlaceholderText="可选" TextChanged="VerdictOutputBox_OnTextChanged" />
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,2,0,0">
                  <StackPanel Width="150">
                    <TextBlock Classes="form-label" Text="判定类型" />
                    <ComboBox Name="VerdictTypeCombo" HorizontalAlignment="Stretch" SelectionChanged="VerdictTypeCombo_OnSelectionChanged" />
                  </StackPanel>
                  <WrapPanel Name="NumericJudgePanel" Orientation="Horizontal">
                    <StackPanel Width="90" Margin="0,0,8,0">
                      <TextBlock Classes="form-label" Text="下限" />
                      <TextBox Name="NumericLowerBox" TextChanged="NumericLowerBox_OnTextChanged" />
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,8,0">
                      <TextBlock Classes="form-label" Text="上限" />
                      <TextBox Name="NumericUpperBox" TextChanged="NumericUpperBox_OnTextChanged" />
                    </StackPanel>
                    <StackPanel Width="110" Margin="0,0,8,0">
                      <TextBlock Classes="form-label" Text="来源单位" />
                      <TextBox Name="NumericSourceUnitBox" PlaceholderText="可选" TextChanged="NumericSourceUnitBox_OnTextChanged" />
                    </StackPanel>
                    <StackPanel Width="110">
                      <TextBlock Classes="form-label" Text="判定单位" />
                      <TextBox Name="NumericUnitBox" PlaceholderText="如 V" TextChanged="NumericUnitBox_OnTextChanged" />
                    </StackPanel>
                  </WrapPanel>
                  <Grid Name="StringJudgePanel" ColumnDefinitions="128,*">
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Classes="form-label" Text="匹配方式" />
                      <ComboBox Name="StringModeCombo" HorizontalAlignment="Stretch" SelectionChanged="StringModeCombo_OnSelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Classes="form-label" Text="期望字符串/正则" />
                      <TextBox Name="ExpectedStringBox" HorizontalAlignment="Stretch" TextChanged="ExpectedStringBox_OnTextChanged" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,12,0,0">
              <TextBlock Classes="hint" FontWeight="SemiBold" Text="Step 管理" />
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <TextBlock Classes="hint" Text="选择“添加 Step”以打开插件分类列表。" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="添加 Step" MinWidth="88" Margin="8,0,0,0" Click="AddStep_OnClick" />
              </Grid>
              <Border Classes="inner" Grid.Row="2" Margin="0,10,0,0" Padding="10,8">
                <TextBlock Name="TreeSelectionText" Classes="hint" TextWrapping="Wrap" />
              </Border>
            </Grid>
          </Grid>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Column="3" Width="10" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

      <Border Classes="card" Grid.Column="4">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Classes="section-title" Text="变量" />
          <ListBox Grid.Row="1" Name="VariablesList" Margin="0,8,0,0" SelectionChanged="VariablesList_OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Classes="hint" Text="{Binding ValueText}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2">
            <TextBlock Classes="form-label" Text="名称" />
            <TextBox Name="VariableNameBox" TextChanged="VariableNameBox_OnTextChanged" />
            <TextBlock Classes="form-label" Text="值" />
            <TextBox Name="VariableValueBox" TextChanged="VariableValueBox_OnTextChanged" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
              <Button Content="添加" Click="AddVariable_OnClick" />
              <Button Content="删除" Click="DeleteVariable_OnClick" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- 日志分隔条：拖动可调整主编辑区与日志区的高度 -->
    <GridSplitter Grid.Row="2" Height="10" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

    <!-- 执行日志 -->
    <Border Classes="card" Grid.Row="3" Padding="12,10">
      <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Classes="section-title" Text="执行日志" />
          <TextBlock Grid.Column="1" Classes="hint" Text="运行输出与校验信息"
                     VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <TextBox Grid.Row="1" Name="LogBox" Classes="log" Margin="0,8,0,0"
                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
