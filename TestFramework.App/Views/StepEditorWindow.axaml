<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TestFramework.App.Views.StepEditorWindow"
        Title="编辑 Step 属性"
        Width="640"
        Height="800"
        MinWidth="540"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">
  <Grid RowDefinitions="*,Auto" Margin="14">
    <Border Classes="card">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconStep}" Width="18" Height="18" Foreground="{DynamicResource AppAccentBrush}" />
            <TextBlock Classes="section-title" Text="Step 属性配置" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <StackPanel>
              <TextBlock Classes="form-label" Text="Step 名称" />
              <TextBox Name="StepNameBox" TextChanged="StepNameBox_OnTextChanged" />
            </StackPanel>
            <CheckBox Grid.Column="1" Name="StepEnabledBox" Content="启用 Step" Margin="12,0,0,0" VerticalAlignment="Bottom"
                      IsCheckedChanged="StepEnabledBox_OnChanged" FontWeight="SemiBold" />
          </Grid>

          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Classes="form-label" Text="绑定插件" />
              <TextBox Name="StepPluginBox" IsReadOnly="True" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Classes="form-label" Text="超时时间 (ms)" />
              <TextBox Name="TimeoutBox" PlaceholderText="留空表示不限制超时" TextChanged="TimeoutBox_OnTextChanged" />
            </StackPanel>
          </Grid>

          <StackPanel Margin="0,4,0,0">
            <TextBlock Classes="form-label" Text="错误处理策略" />
            <ComboBox Name="ErrorHandlingBox" HorizontalAlignment="Stretch" SelectionChanged="ErrorHandlingBox_OnSelectionChanged">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <Separator Margin="0,12,0,6" />

          <!-- 插件特定设置视图容器 -->
          <ContentControl Name="PluginSettingsContent" />

          <Separator Margin="0,12,0,6" />

          <!-- 原始参数管理 -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{DynamicResource AppAccentBrush}" />
            <TextBlock Classes="section-title" Text="原始参数" />
          </StackPanel>

          <ListBox Name="ParametersList" Height="130" Margin="0,4,0,0" Background="Transparent" SelectionChanged="ParametersList_OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="Consolas, Cascadia Code, Monospace" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Classes="hint" Text="{Binding ValueText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Classes="form-label" Text="参数键 (Key)" />
              <TextBox Name="ParameterKeyBox" TextChanged="ParameterKeyBox_OnTextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Classes="form-label" Text="参数值 (Value)" />
              <TextBox Name="ParameterValueBox" TextChanged="ParameterValueBox_OnTextChanged" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Click="AddParameter_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" />
                <TextBlock Text="添加参数" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="danger" Click="DeleteParameter_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconDelete}" Width="12" Height="12" />
                <TextBlock Text="删除参数" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Separator Margin="0,12,0,6" />

          <!-- 变量写入配置 -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconVariable}" Width="14" Height="14" Foreground="{DynamicResource AppAccentBrush}" />
            <TextBlock Classes="section-title" Text="变量写入" />
          </StackPanel>

          <ListBox Name="VariableWritesList" Height="130" Margin="0,4,0,0" Background="Transparent" SelectionChanged="VariableWritesList_OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas, Cascadia Code, Monospace" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Classes="hint" Text="{Binding SourceText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Classes="form-label" Text="目标变量名" />
          <TextBox Name="VariableWriteNameBox" TextChanged="VariableWriteNameBox_OnTextChanged" />

          <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Classes="form-label" Text="输出键" />
              <TextBox Name="VariableWriteOutputKeyBox" PlaceholderText="留空则写入固定值" TextChanged="VariableWriteOutputKeyBox_OnTextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="6,0,0,0">
              <TextBlock Classes="form-label" Text="固定值" />
              <TextBox Name="VariableWriteValueBox" PlaceholderText="字面值或 ${变量名}" TextChanged="VariableWriteValueBox_OnTextChanged" />
            </StackPanel>
          </Grid>

          <CheckBox Name="VariableWriteOnErrorBox" Content="发生错误时也强制写入" Margin="0,8,0,0"
                    IsCheckedChanged="VariableWriteOnErrorBox_OnChanged" FontWeight="SemiBold" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Click="AddVariableWrite_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12" />
                <TextBlock Text="添加写入规则" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="danger" Click="DeleteVariableWrite_OnClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource IconDelete}" Width="12" Height="12" />
                <TextBlock Text="删除写入规则" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Classes="accent" MinWidth="96" Click="Close_OnClick">
        <TextBlock Text="关闭" VerticalAlignment="Center" />
      </Button>
    </StackPanel>
  </Grid>
</Window>
